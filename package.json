{
  "name": "nexus-cloud-dora-compliance",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:dora": "next dev -p 3000",
    "dev:privacy": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node scripts/setup-data.js",
    "setup:assets": "node scripts/create-mock-assets.js",
    "setup:questionnaire": "node scripts/create-dora-questionnaire.js",
    "setup:chilean-privacy": "node scripts/fetch-chilean-privacy-law.js && tsx scripts/import-chilean-privacy-requirements.js && tsx scripts/create-chilean-privacy-questionnaire.js",
    "setup:chilean-privacy-complete": "bash scripts/setup-chilean-privacy-complete.sh",
    "populate:chilean-privacy": "node scripts/populate-chilean-privacy-data.js",
    "test:controls-fallback": "node scripts/test-controls-requirements-fallback.js",
    "test:matching-comparison": "node scripts/compare-matching-approaches.js",
    "test:coherence": "node scripts/analyze-matching-coherence.js",
    "test:matching-suite": "node scripts/test-matching-engine-suite.js",
    "test:matching-integration": "node scripts/test-matching-integration.js",
    "test:matching-flow": "node scripts/test-matching-engine-flow.js",
    "test:question-mapping": "node scripts/test-question-requirement-mapping.js",
    "test:matching-completeness": "node scripts/test-matching-completeness.js",
    "test:chilean-privacy-completeness": "node scripts/test-chilean-privacy-completeness.js",
    "test:chilean-privacy-flow": "node scripts/test-chilean-privacy-engine-flow.js",
    "test:chilean-privacy-suite": "node scripts/test-chilean-privacy-suite.js",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "check": "npm run test:ci",
    "check:full": "npm run lint && npm run build && npm run test:ci",
    "test:regulation-and-stats": "USE_LOCAL_STORAGE=true tsx scripts/test-regulation-and-stats.ts",
    "precompute:mappings": "tsx scripts/precompute-mappings.ts",
    "precompute:mappings:privacy": "tsx scripts/precompute-chilean-privacy-mappings.ts",
    "parse:chilean-privacy": "node scripts/parse-chilean-privacy-law.js",
    "prepopulate:privacy": "tsx scripts/prepopulate-privacy-data.ts",
    "load:privacy": "tsx scripts/load-all-privacy-data.ts",
    "load:all": "tsx scripts/load-all-data.ts",
    "load:chilean-privacy": "tsx scripts/load-all-chilean-privacy-data.ts",
    "export:requirements": "tsx scripts/export-requirements-to-json.ts",
    "export:mappings": "tsx scripts/export-mappings-to-json.ts",
    "export:all": "tsx scripts/export-requirements-to-json.ts && tsx scripts/export-mappings-to-json.ts",
    "import:mappings": "tsx scripts/import-mappings-from-json.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.17.0",
    "@hookform/resolvers": "^3.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@xenova/transformers": "^2.17.2",
    "autoprefixer": "^10.4.16",
    "bcryptjs": "^2.4.3",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "next": "^14.0.4",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "jest": "^29.7.0",
    "tsx": "^4.21.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "14.2.33"
  }
}
