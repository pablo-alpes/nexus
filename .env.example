# MongoDB (required for production / Docker with DB)
# When set, the app uses MongoDB instead of local JSON files.
MONGODB_URI=mongodb://localhost:27017/nexus

# JWT secret for auth tokens (change in production)
JWT_SECRET=your-secret-key-change-in-production

# Optional: force local file storage even if MONGODB_URI is set (dev only)
# USE_LOCAL_STORAGE=true
